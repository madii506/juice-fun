{
  "cleanUrls": true,
  "regions": ["iad1"],
  "functions": { "api/juice.js": { "maxDuration": 30, "memory": 1024 } },
  "rewrites": [
    { "source": "/api/:op(health|config|stocks|chart|logo|sol)", "destination": "/api/juice?op=:op" },
    { "source": "/launch", "destination": "/" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" } ] }
  ]
}
